          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('no caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "const body = pm.response.json();",
                  "pm.test('echoes the query', () => pm.expect(body.query).to.eql('document'));",
                  "pm.test('finds at least one asset', () => pm.expect(body.total).to.be.above(0));",
                  "pm.test('result shape', () => body.results.forEach(r => { pm.expect(r).to.have.all.keys('asset', 'score', 'matchedTags'); pm.expect(r.matchedTags).to.be.an('array'); }));",
                  "pm.test('only ready assets are searchable', () => body.results.forEach(r => pm.expect(r.asset.status).to.eql('ready')));",
                  "pm.test('no internal fields leak', () => body.results.forEach(r => { pm.expect(r.asset).to.not.have.property('fileId'); pm.expect(r.asset).to.not.have.property('aiProvider'); }));",
                  "pm.test('results are ranked, best first', () => { const scores = body.results.map(r => r.score); pm.expect(scores).to.eql([...scores].sort((a, b) => b - a)); });",
                  "pm.collectionVariables.set('documentTotal', String(body.total));"
                ]
              }
            }
          ]
        },
