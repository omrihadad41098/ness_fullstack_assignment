              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('paging defaults', () => { pm.expect(body.page).to.eql(1); pm.expect(body.limit).to.eql(20); });",
                  "pm.test('total counts every asset', () => pm.expect(body.total).to.be.at.least(2));",
                  "pm.test('includes the uploaded assets', () => {",
                  "  const ids = body.assets.map(a => a.id);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get('textAssetId'));",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get('imageAssetId'));",
                  "});",
                  "pm.test('newest first', () => {",
                  "  const times = body.assets.map(a => Date.parse(a.createdAt));",
                  "  pm.expect(times).to.eql([...times].sort((a, b) => b - a));",
                  "});"
                ]
              }
            }
          ]
        },
