{
  "info": {
    "name": "KMS API",
    "description": "Knowledge Management System API. Folders: Health, Assets, Search, Errors.\n\nRun with the `local` or `deployed` environment. Upload requests reference files in `samples/`, so run newman from the repository root:\n\n    npx newman run postman/kms.postman_collection.json -e postman/local.postman_environment.json\n\nIn the Postman app the file paths must be re-selected once (Postman does not read relative paths from the collection for security reasons).\n\nThe Assets folder is self-cleaning: it deletes everything it uploads, so it can be run repeatedly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('no caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "pm.test('returns a request id', () => pm.expect(pm.response.headers.get('x-request-id')).to.be.a('string'));",
                  "const body = pm.response.json();",
                  "pm.test('status ok', () => pm.expect(body.status).to.eql('ok'));",
                  "pm.test('db is up', () => pm.expect(body.db).to.eql('up'));",
                  "pm.test('reports the ai provider', () => pm.expect(body.aiProvider).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Assets",
      "item": [
        {
          "name": "POST /api/assets (text + image)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": "samples/notes.txt"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "samples/swatch.png"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/assets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.test('no caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "const body = pm.response.json();",
                  "pm.test('one asset per uploaded file', () => pm.expect(body.assets).to.have.lengthOf(2));",
                  "const text = body.assets.find(a => a.kind === 'text');",
                  "const image = body.assets.find(a => a.kind === 'image');",
                  "pm.test('text file detected', () => { pm.expect(text).to.be.an('object'); pm.expect(text.originalName).to.eql('notes.txt'); pm.expect(text.mimeType).to.eql('text/plain'); });",
                  "pm.test('image detected', () => { pm.expect(image).to.be.an('object'); pm.expect(image.originalName).to.eql('swatch.png'); pm.expect(image.mimeType).to.eql('image/png'); });",
                  "pm.test('sizes recorded', () => body.assets.forEach(a => pm.expect(a.sizeBytes).to.be.above(0)));",
                  "pm.test('awaiting AI metadata', () => body.assets.forEach(a => pm.expect(a.status).to.eql('pending')));",
                  "pm.test('contentUrl is relative', () => body.assets.forEach(a => pm.expect(a.contentUrl).to.eql('/api/assets/' + a.id + '/content')));",
                  "pm.collectionVariables.set('textAssetId', text.id);",
                  "pm.collectionVariables.set('imageAssetId', image.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/assets",
          "request": {
            "method": "GET",
            "header": [],
