    {
      "name": "Search",
      "item": [
        {
          "name": "POST /api/assets (search fixtures)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": "samples/notes.txt"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "samples/checklist.md"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "samples/swatch.png"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/assets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const assets = pm.response.json().assets;",
                  "pm.test('three fixtures uploaded', () => pm.expect(assets).to.have.lengthOf(3));",
                  "pm.collectionVariables.set('searchIds', assets.map(a => a.id).join(','));",
                  "pm.collectionVariables.set('searchTextId', assets.find(a => a.originalName === 'notes.txt').id);",
                  "pm.collectionVariables.set('searchImageId', assets.find(a => a.kind === 'image').id);",
                  "pm.collectionVariables.set('readyAttempts', '0');"
                ]
              }
            }
          ]
        },
        {
          "name": "/api/assets (wait for AI metadata)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assets?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Analysis is asynchronous, so this request re-runs itself until every fixture is out of the queue.",
                  "const wanted = pm.collectionVariables.get('searchIds').split(',');",
                  "const byId = new Map(pm.response.json().assets.map(a => [a.id, a]));",
                  "const settled = wanted.every(id => [\"ready\", \"failed\"].includes((byId.get(id) || {}).status));",
                  "const attempts = Number(pm.collectionVariables.get('readyAttempts')) + 1;",
                  "pm.collectionVariables.set('readyAttempts', String(attempts));",
                  "if (!settled && attempts < 30) { pm.execution.setNextRequest(pm.info.requestName); } else {",
                  "  pm.test('every fixture finished processing', () => wanted.forEach(id => pm.expect((byId.get(id) || {}).status).to.eql('ready')));",
                  "  pm.test('metadata was stored', () => wanted.forEach(id => pm.expect(byId.get(id).tags.length + byId.get(id).keywords.length).to.be.above(0)));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/search?q=document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/search?q=document",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "document"
