                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const asset = pm.response.json();",
                  "pm.test('queued again', () => pm.expect(asset.status).to.eql('pending'));",
                  "pm.test('previous error cleared', () => pm.expect(asset.error).to.eql(null));"
                ]
              }
