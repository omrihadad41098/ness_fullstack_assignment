# Copy to server/.env and fill in. Never commit .env.

PORT=3000
NODE_ENV=development

# Local: docker run -d --name kms-mongo -p 27017:27017 mongo:7
# Production: MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/kms

# gemini | fake  (use `fake` to run fully offline without an API key)
AI_PROVIDER=fake
GEMINI_API_KEY=
# Optional: override the provider's default model id (gemini default: gemini-3.8-flash)
AI_MODEL=
# Assets analysed at the same time; keep low so one big upload can't exhaust the API quota
AI_CONCURRENCY=2

MAX_UPLOAD_MB=10
# debug | info | warn | error
LOG_LEVEL=info
# Built client served by Express in production (relative to the server working directory)
CLIENT_DIST_DIR=../client/dist
